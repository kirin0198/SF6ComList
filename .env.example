# ===========================================
# データベース設定
# ===========================================
# SQLite DB ファイルのパス
# ローカル開発時: file:../data/sf6combo.db
# Docker / Cloud Run 時: file:/app/data/sf6combo.db
DATABASE_URL="file:../data/sf6combo.db"

# ===========================================
# Auth.js (NextAuth v5) 設定
# ===========================================
# JWT 署名・暗号化に使用するシークレットキー
# 以下のコマンドでランダムな値を生成すること:
#   openssl rand -base64 32
# "your-secret-key-here" のまま運用しないこと
AUTH_SECRET="your-secret-key-here"

# アプリケーションの公開 URL
# Cloud Run デプロイ時は自動的に割り当てられる URL を設定:
#   例: https://sf6comlist-xxxxxxxxxx-an.a.run.app
AUTH_URL="http://localhost:3000"

# 後方互換（next-auth v4 互換）
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# ===========================================
# Cloud Run / GCS 設定（本番環境のみ）
# ===========================================
# SQLite DB を永続化する GCS バケット名
# Cloud Run はステートレスなため、GCS に DB ファイルを保存して起動時に復元する
# ローカル開発時は空にすること（未設定時はローカルボリュームを使用）
# 例: sf6comlist-db-abc123
GCS_BUCKET_NAME=

# ===========================================
# Google Cloud 設定（CI/CD 用 - 通常は GitHub Secrets で管理）
# ===========================================
# Google Cloud プロジェクト ID
# GitHub Actions の Secrets に GCP_PROJECT_ID として設定すること
# GCP_PROJECT_ID=

# Workload Identity Federation プロバイダーのリソース名
# 例: projects/123456789/locations/global/workloadIdentityPools/github-pool/providers/github-provider
# GitHub Actions の Secrets に GCP_WORKLOAD_IDENTITY_PROVIDER として設定すること
# GCP_WORKLOAD_IDENTITY_PROVIDER=

# デプロイ用サービスアカウントのメールアドレス
# 例: sf6comlist-deployer@PROJECT_ID.iam.gserviceaccount.com
# GitHub Actions の Secrets に GCP_SERVICE_ACCOUNT として設定すること
# GCP_SERVICE_ACCOUNT=
